# Copy to .env. Compose overrides the two URLs with its own service names.

DATABASE_URL=postgresql://pulsewatch:pulsewatch@localhost:5432/pulsewatch
REDIS_URL=redis://localhost:6379/0

# How often Beat wakes the dispatcher. Not the check interval — each target
# carries its own.
DISPATCH_INTERVAL_SECONDS=10

# Service-wide ceiling on a single probe, whatever a target asks for.
MAX_PROBE_TIMEOUT_SECONDS=30

# Fallback thresholds for targets that do not set their own.
DEFAULT_FAILURE_THRESHOLD=3
DEFAULT_RECOVERY_THRESHOLD=2

# Probe history older than this is pruned hourly. Incidents are kept forever.
CHECK_RETENTION_DAYS=30

LOG_LEVEL=INFO
ENVIRONMENT=local
